{
  "manifest_version": 3,
  "name": "VortexDM Browser Bridge",
  "version": "0.1.0",
  "description": "Send browser downloads to VortexDM. Android ad blocking is provided separately by the official uBlock Origin add-on.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VortexDM",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "vortex-browser-bridge@vortexdm.local",
      "strict_min_version": "128.0"
    }
  }
}
