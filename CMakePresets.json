{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Desktop (vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VORTEX_BUILD_TESTS": "ON",
        "VORTEX_BUILD_UI": "OFF"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64 core (vcpkg + NDK)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "CMAKE_HAVE_LIBC_PTHREAD": "ON",
        "VORTEX_BUILD_TESTS": "OFF",
        "VORTEX_BUILD_UI": "OFF"
      }
    }
  ],
  "buildPresets": [
    {"name": "default", "configurePreset": "default"},
    {"name": "android-arm64", "configurePreset": "android-arm64"}
  ],
  "testPresets": [
    {"name": "default", "configurePreset": "default", "output": {"outputOnFailure": true}}
  ]
}
